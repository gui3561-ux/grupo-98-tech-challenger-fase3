# Diretórios de artefatos
MODEL_DIR=models
DATA_DIR=data
REPORTS_DIR=reports

# Nomes dos artefatos
MODEL_NAME=urgency_classifier
ONNX_MODEL_NAME=urgency_classifier.onnx

# N_SAMPLES só é usado pelo gerador sintético legado (src/services/data_generator.py),
# não pelo pipeline padrão (Medical Abstracts TC Corpus, sem tamanho fixo configurável).
N_SAMPLES=2000
RANDOM_STATE=42
TEST_SIZE=0.2

# Texto de semente usado no benchmark
SEED_TEXT=Exame sem achados relevantes, tudo dentro da normalidade.
